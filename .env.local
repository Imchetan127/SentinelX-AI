# ==============================================================================
# SentinelX AI Platform Local Host Overrides (.env.local)
# Used when running services directly on host machine (outside Docker)
# ==============================================================================

# Local PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sentinelx_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinelx_db

# Security & Authentication
JWT_SECRET=production_super_secret_jwt_key_sentinelx_2026

# Local Storage Directories (Relative to backend/)
MODEL_DIR=../models
DATASETS_DIR=../datasets
REPORTS_DIR=../reports
LOGS_DIR=../logs
LOG_LEVEL=INFO

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
